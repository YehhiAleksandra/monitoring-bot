[Unit]
Description=Monitoring agent (HTTP metrics)
After=network.target

[Service]
Type=simple
User=root
Environment=AGENT_PORT=9101
# EnvironmentFile=/etc/monitoring-agent.env
ExecStart=/usr/bin/python3 /opt/monitoring-agent/agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
