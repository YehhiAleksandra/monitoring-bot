[Unit]
Description=Telegram monitoring bot
After=network.target

[Service]
Type=simple
User=monitoring
WorkingDirectory=/opt/monitoring-bot
EnvironmentFile=/etc/monitoring-bot.env
ExecStart=/opt/monitoring-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
